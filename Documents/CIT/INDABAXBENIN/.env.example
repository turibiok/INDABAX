# GEMINI_API_KEY : requis pour l'assistant IA (endpoints /api/ai/*).
# Sans cette clé, l'application fonctionne mais l'onglet "Guide IA" renvoie une erreur.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL : URL publique de l'application, utilisée pour les liens auto-référents.
APP_URL="MY_APP_URL"

# La base de données (comptes, rôles, sessions, présences) est un classeur Google Sheet
# relié depuis l'application via son lien de partage : aucune clé ni projet Google Cloud
# n'est nécessaire. Voir "Base Google Sheet" dans les paramètres de l'application.
