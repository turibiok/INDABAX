# GEMINI_API_KEY : requis pour l'assistant IA (endpoints /api/ai/*).
# Sans cette clé, l'application fonctionne mais l'onglet "Guide IA" renvoie une erreur.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ADMIN_EMAILS : emails autorisés à ouvrir l'espace Super-Admin même si aucun
# classeur n'est encore lié. C'est la porte d'entrée de la première
# installation : sans elle, personne ne pourrait configurer l'application.
# Séparez plusieurs adresses par des virgules.
ADMIN_EMAILS="vous@exemple.bj"

# APP_URL : URL publique de l'application, utilisée pour les liens auto-référents.
APP_URL="MY_APP_URL"

# La base de données (comptes, rôles, sessions, présences) est un classeur Google
# Sheet relié depuis l'application via son lien de partage : aucune clé ni projet
# Google Cloud n'est nécessaire. Le lien et les secrets d'écriture sont enregistrés
# côté serveur dans .data/server-state.json, jamais dans le navigateur.
# Voir "Base Google Sheet" dans les paramètres de l'application.

# ADMIN_PASSWORD : mot de passe des emails listés dans ADMIN_EMAILS. Sans lui,
# ces comptes d'amorçage ne peuvent pas se connecter.
ADMIN_PASSWORD="choisissez-un-mot-de-passe-solide"
