# ------------------------------------------------------------------
# IndabaX Bénin 2026 — modèle de configuration
#
# Ce fichier est un MODÈLE : l'application ne le lit jamais.
# Copiez-le en `.env` (jamais versionné) pour un usage local, ou reportez
# ces variables dans le tableau de bord de votre hébergeur.
#
# N'écrivez donc aucun mot de passe réel ici : ce fichier est dans le dépôt
# Git, et tout ce qui y entre reste dans l'historique.
# ------------------------------------------------------------------

# Compte Super-Admin de l'événement.
# Il est créé au premier démarrage s'il n'existe pas déjà. L'opération est
# idempotente : un mot de passe changé depuis l'application n'est pas écrasé
# au redémarrage.
SUPERADMIN_EMAIL="vous@exemple.bj"
SUPERADMIN_PASSWORD="choisissez-un-mot-de-passe-solide"
SUPERADMIN_NAME="Votre Nom"

# Accès de secours, utilisable même si la table des comptes est vide.
# Ces emails obtiennent le rôle Super-Admin sans être enregistrés en base :
# leur mot de passe reste donc ADMIN_PASSWORD, non modifiable depuis l'app.
ADMIN_EMAILS=""
ADMIN_PASSWORD=""

# Assistant IA (onglet « Guide IA »). Sans clé, le reste de l'application
# fonctionne mais cet onglet renvoie une erreur.
GEMINI_API_KEY=""

# Port d'écoute. Les hébergeurs le fournissent en général eux-mêmes.
PORT="3000"

# Cookie de session. `Secure` est activé automatiquement quand
# NODE_ENV=production, ce qui exige HTTPS. Pour une mise en service
# provisoire en HTTP simple, forcez COOKIE_SECURE="false" — sans quoi le
# navigateur refusera de renvoyer le cookie et la connexion échouera sans
# message d'erreur.
# COOKIE_SECURE="false"

# URL publique de l'application, utilisée pour les liens auto-référents.
APP_URL=""

# ------------------------------------------------------------------
# Configuration du classeur par l'environnement (optionnel)
#
# Utile sur un hébergement sans disque persistant : ces variables redonnent
# sa configuration à l'application à chaque démarrage, et le serveur vérifie
# le classeur tout seul. Une valeur déjà enregistrée depuis l'interface
# n'est jamais écrasée.
# ------------------------------------------------------------------
SHEET_URL=""
SHEET_USERS_TAB="Utilisateurs"
SHEET_PARTICIPANTS_TAB="Participants"
SHEET_SESSIONS_TAB="Sessions"
SHEET_CHECKINS_TAB="Check-ins"
SHEET_FEEDBACKS_TAB="Feedbacks"

# Voie d'écriture (émargements et feedbacks vers le classeur).
APPS_SCRIPT_URL=""
APPSHEET_APP_ID=""
APPSHEET_ACCESS_KEY=""

# ------------------------------------------------------------------
# La base de données (comptes, rôles, sessions, présences) est un classeur
# Google Sheet relié par son lien de partage : aucune clé ni projet Google
# Cloud n'est nécessaire. Le lien et les secrets d'écriture sont enregistrés
# côté serveur dans .data/server-state.json, jamais dans le navigateur.
#
# Voir docs/MODELE-CLASSEUR.md, docs/DEPLOIEMENT.md et
# docs/DEPLOIEMENT-RENDER.md.
# ------------------------------------------------------------------
